# Production origin (https only, no trailing slash, no path). Required for:
# canonical URLs, Open Graph image URLs, sitemap.xml, robots.txt Sitemap line, and absolute JSON-LD URLs.
# Example: SITE_URL=https://forcecar.md
SITE_URL=https://www.example.md

# Optional tracking. Leave empty to ship no cookies and no consent banner.
# Setting either one turns on the consent banner, the preferences panel and the footer link automatically.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
